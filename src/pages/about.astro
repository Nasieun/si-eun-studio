---
import BaseLayout from '../layouts/BaseLayout.astro';
import Todo from '../components/Todo.astro';
import { ABOUT, CONTACTS, SITE } from '../data/site';
import { url } from '../lib/url';

const toolGroups = [...new Set(ABOUT.tools.map((t) => t.group))];
---

<BaseLayout title="소개" description="사용자가 무엇을 보고, 느끼고, 어려워하는지에 관심을 두고 경험을 설계하는 시은을 소개합니다.">
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1>소개</h1>
    </header>

    <div class="about">
      <section class="prose about__intro" aria-label="소개 글">
        {ABOUT.paragraphs.map((p) => <p>{p}</p>)}
      </section>

      <div class="about__side">
        <section class="card" aria-labelledby="interests-title">
          <h2 id="interests-title" class="about__h">관심 분야</h2>
          <ul class="badge-row plain" role="list">
            {ABOUT.interests.map((tag) => <li class="badge">{tag}</li>)}
          </ul>
        </section>

        <section class="card" aria-labelledby="tools-title">
          <h2 id="tools-title" class="about__h">실제로 사용한 도구</h2>
          <dl class="tools">
            {
              toolGroups.map((g) => (
                <div>
                  <dt>{g}</dt>
                  {ABOUT.tools
                    .filter((t) => t.group === g)
                    .map((t) => (
                      <dd>
                        {t.name}
                        {!t.verified && <Todo label="사용 여부 확인 필요" />}
                      </dd>
                    ))}
                </div>
              ))
            }
          </dl>
        </section>

        <section class="card" aria-labelledby="contact-title" id="contact">
          <h2 id="contact-title" class="about__h">연락하기</h2>
          <ul class="contacts plain" role="list">
            {
              CONTACTS.map((c) => (
                <li class="contact">
                  <span class="contact__label">{c.label}</span>
                  {c.value === null ? (
                    <Todo label="공개할 값 입력 필요" />
                  ) : c.kind === 'email' ? (
                    <span class="contact__row">
                      <a href={`mailto:${c.value}`}>{c.value}</a>
                      <button class="btn" type="button" data-copy={c.value}>
                        복사
                      </button>
                    </span>
                  ) : (
                    <a href={c.value} rel="noopener">
                      {c.display ?? c.value}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
          <p class="caption" role="status" aria-live="polite" data-copy-status></p>
          {
            ABOUT.resumePdf && (
              <a class="btn btn--primary resume" href={url(ABOUT.resumePdf)} download>
                이력서 PDF 내려받기
              </a>
            )
          }
        </section>
      </div>
    </div>

    <section class="section ai-notice" id="ai-notice" aria-labelledby="ai-title">
      <h2 id="ai-title" class="section-title">AI 활용 안내</h2>
      <div class="prose">
        <p>
          {SITE.name}은 웹사이트 구현과 글 초안 정리, 보조 일러스트, 품질 점검에 AI(Claude)를 활용했어요. 각 프로젝트
          개요에는 그 프로젝트에서 AI를 어디에 썼는지 따로 표시해 두었어요.
        </p>
        <p>
          어떤 불편을 발견했는지, 무엇을 근거로 어떤 결정을 내렸는지, 결과를 어떻게 확인했는지는 모두 {SITE.owner}의
          작업이에요. 실제로 측정하지 않은 효과는 ‘개선 가설’로 구분해 표시했어요.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        if (status) status.textContent = '이메일 주소를 복사했어요.';
        btn.textContent = '복사됨';
        setTimeout(() => (btn.textContent = '복사'), 2000);
      } catch {
        if (status) status.textContent = '복사하지 못했어요. 주소를 직접 선택해 복사해 주세요.';
      }
    });
  });
</script>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .about {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .about__intro {
    font-size: calc(var(--fs-body) + 2px);
    line-height: 1.85;
  }

  .about__side {
    display: grid;
    gap: var(--space-4);
  }

  .about__h {
    font-size: 18px;
    margin-bottom: var(--space-3);
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tools {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .tools dt {
    font-size: var(--fs-caption);
    color: var(--text-secondary);
    font-weight: 600;
  }

  .tools dd {
    margin: 0;
  }

  .contacts {
    display: grid;
    gap: var(--space-3);
  }

  .contact {
    display: grid;
    gap: 2px;
  }

  .contact__label {
    font-size: var(--fs-caption);
    color: var(--text-secondary);
    font-weight: 600;
  }

  .contact a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    word-break: break-all;
  }

  .contact__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .resume {
    margin-top: var(--space-4);
  }

  .ai-notice {
    margin-top: var(--space-7);
    border-top: 1px solid var(--border);
  }
</style>
