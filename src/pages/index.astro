---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectThumb from '../components/ProjectThumb.astro';
import { SITE } from '../data/site';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <p class="eyebrow">{SITE.nameEn} · {SITE.owner}</p>
    <h1 id="hero-title" class="hero__title">
      사람이 느끼는 작은 불편을 발견하고,<br />
      더 나은 경험을 설계합니다.
    </h1>
    <p class="hero__sub">관찰에서 시작해 서비스와 화면으로 구체화한 작업들을 소개합니다.</p>
  </section>

  <section class="container section" aria-labelledby="problems-title">
    <h2 id="problems-title" class="section-title">이런 질문에서 시작했어요</h2>
    <ul class="grid grid--3 problem-list" role="list">
      {
        projects.map((p, i) => (
          <li class="card card--link problem">
            <span class="problem__num" aria-hidden="true">
              0{i + 1}
            </span>
            <h3 class="problem__q">
              <a class="card__link" href={url(`/projects/${p.id}`)}>
                {p.data.question}
              </a>
            </h3>
            <div class="problem__reveal">
              <ProjectThumb slug={p.id} />
              <p class="problem__name">
                <span class="visually-hidden">프로젝트: </span>
                {p.data.title}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container section" aria-labelledby="more-title">
    <h2 id="more-title" class="visually-hidden">더 둘러보기</h2>
    <div class="grid more">
      <article class="card card--link more__item">
        <p class="eyebrow">가치관으로 읽기</p>
        <h3>
          <a class="card__link" href={url('/approach')}>나의 설계 방식</a>
        </h3>
        <p class="muted">책임·한결같음·자신감·성취감·열정이 실제 작업에서 어떤 수정으로 나타났는지 따라가 보세요.</p>
        <div class="badge-row" aria-hidden="true">
          <span class="badge badge--lavender">책임</span>
          <span class="badge badge--lavender">한결같음</span>
          <span class="badge badge--lavender">자신감</span>
          <span class="badge badge--lavender">성취감</span>
          <span class="badge badge--lavender">열정</span>
        </div>
      </article>
      <article class="card card--link more__item">
        <p class="eyebrow">대표작을 뒷받침하는 기록</p>
        <h3>
          <a class="card__link" href={url('/archive')}>관찰과 탐구</a>
        </h3>
        <p class="muted">XR 체험 보고서, VR 멀미 논문 분석, 봉사 카드뉴스처럼 관찰하고 해석한 기록을 모았어요.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .hero__title {
    margin-top: var(--space-4);
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.02em;
    max-width: 22em;
  }

  .hero__sub {
    margin-top: var(--space-4);
    color: var(--text-secondary);
    font-size: calc(var(--fs-body) + 1px);
    max-width: var(--text-max);
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-9) var(--space-7);
    }
  }

  .problem-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .problem {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .problem__num {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
  }

  .problem__q {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.5;
  }

  .problem__reveal {
    margin-top: auto;
    display: grid;
    gap: var(--space-3);
  }

  .problem__name {
    font-size: 15px;
    font-weight: 600;
  }

  .problem__name::after {
    content: ' →';
  }

  /* H-3: 마우스가 있는 큰 화면에서는 호버·포커스 때 미리보기가 드러난다.
     터치 기기·작은 화면에서는 항상 보인다 (내용이 숨지 않도록). */
  @media (hover: hover) and (min-width: 1024px) {
    /* 장식 이미지만 흐리게 — 프로젝트명 글자는 대비를 유지한다 */
    .problem__reveal :global(.thumb) {
      opacity: 0.5;
      transform: translateY(6px);
      transition:
        opacity var(--dur-slow) var(--ease-out),
        transform var(--dur-slow) var(--ease-out);
    }
    .problem:hover .problem__reveal :global(.thumb),
    .problem:focus-within .problem__reveal :global(.thumb) {
      opacity: 1;
      transform: none;
    }
  }

  .more__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .more__item h3 {
    font-size: 20px;
  }
</style>
