---
/** 아직 만들지 않은 페이지의 자리표시 — 주소는 열리되 무엇이 들어올지 알려 준다. */
import { url } from '../lib/url';
interface Props {
  step: string;
}
const { step } = Astro.props;
---

<div class="card soon">
  <span class="badge badge--outline">{step}에서 공개</span>
  <div class="prose"><slot /></div>
  <a class="btn" href={url('/')}>홈으로 돌아가기</a>
</div>

<style>
  .soon {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 760px;
  }
</style>
