---
import { CONTACTS, SITE, AI_NOTICE } from '../data/site';
import { url } from '../lib/url';

const shown = CONTACTS.filter((c) => c.value);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name">{SITE.nameEn}</p>
      <p class="caption">© {SITE.year} {SITE.owner}. {SITE.name}</p>
    </div>

    {
      shown.length > 0 && (
        <ul class="site-footer__contacts" aria-label="연락 수단">
          {shown.map((c) => (
            <li>
              <a
                href={c.kind === 'email' ? `mailto:${c.value}` : c.value!}
                rel={c.kind === 'link' ? 'noopener' : undefined}
              >
                {c.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="caption site-footer__ai">
      {AI_NOTICE} <a href={url('/about#ai-notice')}>AI 활용 안내 보기</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .site-footer__name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  .site-footer__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__contacts a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    font-size: 15px;
    text-decoration: none;
  }

  .site-footer__contacts a:hover {
    background: var(--accent-blue-soft);
  }

  .site-footer__ai a {
    display: inline-block;
    padding-block: 10px; /* 터치 영역 확보 */
  }

  @media (min-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
    .site-footer__contacts {
      justify-content: flex-end;
    }
    .site-footer__ai {
      grid-column: 1 / -1;
    }
  }
</style>
